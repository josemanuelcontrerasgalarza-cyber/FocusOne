# === Supabase ===
# Copia este archivo a `.env.local` y rellena con las claves de tu proyecto.
# .env.local está en .gitignore — NUNCA se commitean claves reales.
# Panel de Supabase → Project Settings → API.

# URL del proyecto (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (pública, segura para el cliente; la seguridad real la
# imponen las políticas RLS de la base de datos).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === Asistente con IA (opcional, solo servidor) ===
# Sin esta clave el asistente muestra que no está configurado y usa el cálculo local.
# NUNCA le pongas el prefijo NEXT_PUBLIC_: debe quedarse en el servidor.
GROQ_API_KEY=
# Opcional. Modelo de Groq (por defecto llama-3.3-70b-versatile).
GROQ_MODEL=
